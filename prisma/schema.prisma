// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnchorStatus {
  LIVE
  DEGRADED
  DOWN
  UNKNOWN

  @@map("anchor_status")
}

enum TransferStatus {
  COMPLETED
  PARTIAL
  REFUNDED
  EXPIRED
  ERROR

  @@map("transfer_status")
}

enum ReputationScoreBand {
  GREEN @map("green")
  AMBER @map("amber")
  RED   @map("red")

  @@map("reputation_score_band")
}

enum ReputationState {
  INSUFFICIENT_DATA @map("insufficient_data")
  OK                @map("ok")

  @@map("reputation_state")
}

/// Issue #167: durable per-source circuit-breaker state for reviewed
/// live-rate sources. Keyed to the reviewed source identity.
enum SourceBreakerState {
  CLOSED
  OPEN
  HALF_OPEN

  @@map("source_breaker_state")
}

model Anchor {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique
  name              String
  homeDomain        String            @map("home_domain")
  tomlUrl           String            @map("toml_url")
  seps              Int[]             @default([])
  isTransferCapable Boolean           @default(false) @map("is_transfer_capable")
  status            AnchorStatus      @default(UNKNOWN)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  corridors        AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]
  reputationScore  ReputationScore?
  healthState      AnchorHealthState?

  @@map("anchors")
}

/// Bounded, per-anchor health evidence for deterministic availability
/// transitions. Counters and timestamps only — no error text — so the pure
/// state machine in lib/stellar/anchorHealth.ts makes identical transitions
/// across process restarts and horizontal execution. One row per anchor.
model AnchorHealthState {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId             String       @unique @map("anchor_id") @db.Uuid
  status               AnchorStatus
  consecutiveFailures  Int          @default(0) @map("consecutive_failures")
  lastFailureClass     String?      @map("last_failure_class")
  lastFailureCode      String?      @map("last_failure_code")
  consecutiveSuccesses Int          @default(0) @map("consecutive_successes")
  lastObservedAt       DateTime?    @map("last_observed_at") @db.Timestamptz(6)
  lastSuccessAt        DateTime?    @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt        DateTime?    @map("last_failure_at") @db.Timestamptz(6)
  lastTransitionAt     DateTime?    @map("last_transition_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  anchor Anchor @relation(fields: [anchorId], references: [id], onDelete: Cascade)

  @@map("anchor_health_states")
}

model Corridor {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetCodeFrom String @map("asset_code_from")
  countryFrom   String @map("country_from")
  assetCodeTo   String @map("asset_code_to")
  countryTo     String @map("country_to")
  slug          String @unique

  anchors          AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]

  @@map("corridors")
}

model AnchorCorridor {
  anchorId   String @map("anchor_id") @db.Uuid
  corridorId String @map("corridor_id") @db.Uuid

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([anchorId, corridorId])
  @@index([corridorId], map: "anchor_corridors_corridor_id_idx")
  @@map("anchor_corridors")
}

/// One individual anchor quote for a corridor. Freshness is derived from
/// capturedAt at read time; computed corridor medians are not stored here.
model RateSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId          String   @map("anchor_id") @db.Uuid
  corridorId        String   @map("corridor_id") @db.Uuid
  rate              Decimal  @db.Decimal(38, 18)
  sourceAmount      Decimal  @map("source_amount") @db.Decimal(38, 18)
  destinationAmount Decimal  @map("destination_amount") @db.Decimal(38, 18)
  fee               Decimal  @default(0) @db.Decimal(38, 18)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([corridorId, capturedAt(sort: Desc)], map: "rate_snapshots_corridor_id_captured_at_idx")
  @@index([anchorId, capturedAt(sort: Desc)], map: "rate_snapshots_anchor_id_captured_at_idx")
  /// Covering index for findLatestObservations
  /// (lib/rates/latestRateRepository.ts), the per-corridor
  /// DISTINCT ON (anchor_id) ... ORDER BY anchor_id, captured_at DESC,
  /// id DESC behind GET /api/rates. The payload columns are index keys only
  /// because Prisma cannot express INCLUDE; after the unique id they never
  /// affect ordering. With every selected column in the index, Postgres
  /// answers the query with an ordered index-only scan — no heap visits and
  /// no sort of the corridor's whole snapshot history.
  @@index([corridorId, anchorId, capturedAt(sort: Desc), id(sort: Desc), rate, sourceAmount, destinationAmount, fee], map: "rate_snapshots_latest_observation_idx")
  /// Serves the reputation evidence read (lib/reputation/repository.ts), the
  /// per-anchor DISTINCT ON (corridor.slug) latest-quote scan: an index-only
  /// scan replaces the bitmap heap scan over the anchor's whole history.
  @@index([anchorId, corridorId, capturedAt(sort: Desc), id(sort: Desc)], map: "rate_snapshots_anchor_corridor_latest_idx")
  @@map("rate_snapshots")
}

model TransferOutcome {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId     String         @map("anchor_id") @db.Uuid
  corridorId   String         @map("corridor_id") @db.Uuid
  status       TransferStatus
  fillRate     Float          @map("fill_rate")
  settlementMs Int            @map("settlement_ms")
  slippage     Float
  recordedAt   DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([anchorId, recordedAt(sort: Desc)], map: "transfer_outcomes_anchor_id_recorded_at_idx")
  @@map("transfer_outcomes")
}

/// One circuit-breaker row per reviewed live-rate source identity.
/// Survives process restarts; concurrent workers coordinate through
/// guarded writes on `recoveryProbeToken` and `recoveryProbesActive`.
model SourceBreaker {
  anchorSlug                     String             @map("anchor_slug")
  corridorSlug                   String             @map("corridor_slug")
  state                          SourceBreakerState @default(CLOSED)
  consecutiveTransportFailures   Int                @default(0) @map("consecutive_transport_failures")
  consecutiveOpens               Int                @default(0) @map("consecutive_opens")
  recentInvalidEvidenceFailures  Int                @default(0) @map("recent_invalid_evidence_failures")
  openAt                         DateTime?          @map("open_at") @db.Timestamptz(6)
  cooldownUntil                  DateTime?          @map("cooldown_until") @db.Timestamptz(6)
  recoveryProbeToken             String?            @map("recovery_probe_token")
  recoveryProbeDeadline          DateTime?          @map("recovery_probe_deadline") @db.Timestamptz(6)
  recoveryProbesActive           Int                @default(0) @map("recovery_probes_active")
  windowStartAt                  DateTime           @default(now()) @map("window_start_at") @db.Timestamptz(6)
  lastFailureAt                  DateTime?          @map("last_failure_at") @db.Timestamptz(6)
  lastSuccessAt                  DateTime?          @map("last_success_at") @db.Timestamptz(6)
  updatedAt                      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([anchorSlug, corridorSlug])
  @@index([state, cooldownUntil], map: "source_breakers_state_cooldown_until_idx")
  @@map("source_breakers")
}

model ReputationScore {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId       String               @unique @map("anchor_id") @db.Uuid
  compositeScore Float?               @map("composite_score")
  scoreBand      ReputationScoreBand? @map("score_band")
  fillRate7d     Float?               @map("fill_rate_7d")
  fillRate30d    Float?               @map("fill_rate_30d")
  fillRate90d    Float?               @map("fill_rate_90d")
  settleP50Ms    Int?                 @map("settle_p50_ms")
  settleP95Ms    Int?                 @map("settle_p95_ms")
  slippageP50    Float?               @map("slippage_p50")
  slippageP95    Float?               @map("slippage_p95")
  sampleSize     Int                  @default(0) @map("sample_size")
  state          ReputationState      @default(INSUFFICIENT_DATA)
  computedAt     DateTime             @default(now()) @map("computed_at") @db.Timestamptz(6)

  anchor Anchor @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("reputation_scores")
}
